# Copy to .env and fill in real values. NEVER commit .env.

# --- Neon Postgres (used from Phase 2 onward) ---
# App runtime: Neon *pooler* endpoint (host contains "-pooler")
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/DBNAME?sslmode=require
# Alembic migrations: Neon *direct* endpoint
DATABASE_URL_DIRECT=postgresql+psycopg://USER:PASSWORD@ep-xxxx.REGION.aws.neon.tech/DBNAME?sslmode=require

# --- Auth ---
JWT_SECRET=change-me-to-a-long-random-string
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me

# --- Feature flags ---
# Face recognition stays OFF unless consented/enrolled persons are configured.
FACE_RECOGNITION_ENABLED=false

# --- Detection ---
DETECTION_MODEL=yolo26n.pt
RETENTION_DAYS=30
